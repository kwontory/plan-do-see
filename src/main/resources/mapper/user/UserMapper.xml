<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plandosee.diary.user.application.port.UserMapper">

    <resultMap id="userRow" type="com.plandosee.diary.user.domain.UserRow">
        <id property="id" column="id"/>
        <result property="nickname" column="nickname"/>
    </resultMap>

    <select id="findActiveById" resultMap="userRow">
        SELECT u.id,
               u.nickname
        FROM users u
        WHERE u.id = #{userId}
          AND u.deleted_at IS NULL
    </select>
</mapper>
