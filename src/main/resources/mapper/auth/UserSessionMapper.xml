<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.plandosee.diary.auth.application.port.UserSessionMapper">

    <!-- Spring Session JDBC tables (V6). SPRING_SESSION_ATTRIBUTES rows go with ON DELETE CASCADE. -->
    <delete id="deleteByPrincipalName">
        DELETE FROM spring_session
        WHERE principal_name = #{principalName}
    </delete>
</mapper>
