# Copy to .env (git-ignored) or set in Render dashboard. Never commit real values.
# JDBC URL without credentials, e.g. jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/plandosee
DB_USERNAME=plandosee
DB_PASSWORD=change-me
# Must match the demo user row created by Flyway V1.
APP_DEMO_USER_ID=00000000-0000-4000-8000-000000000001
PORT=8080
